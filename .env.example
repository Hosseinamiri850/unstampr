# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000
NODE_ENV=development

# Session
SESSION_SECRET=change-me-to-a-32-byte-random-string-min

# Database
DATABASE_URL=postgres://pakino:pakino@localhost:5432/pakino

# Redis
REDIS_URL=redis://localhost:6379

# S3-compatible object storage
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=pakino
S3_SECRET_KEY=pakino12345
S3_BUCKET=pakino

# Limits
MAX_IMAGE_SIZE=10485760
MAX_VIDEO_SIZE=524288000
MAX_VIDEO_DURATION=300
MAX_VIDEO_FRAMES=

# Retention (hours): input and output files auto-deleted after this window
FILE_RETENTION_HOURS=24

# Credits
CREDITS_PER_IMAGE=5
CREDITS_PER_VIDEO_10_SECONDS=10
ANON_FREE_CREDITS=50

# Worker
WORKER_CONCURRENCY=2
PROCESSING_BACKEND=opencv

# Payments - ZarinPal
ZARINPAL_MERCHANT_ID=
ZARINPAL_CALLBACK_URL=http://localhost:3000/api/payments/callback
ZARINPAL_SANDBOX=true

# Queue name shared between Next.js and Python worker
QUEUE_NAME=pakino:jobs

# Payments - Bale (Bot API, wallet)
BALE_BOT_TOKEN=
BALE_PROVIDER_TOKEN=
BALE_WEBHOOK_SECRET=
BALE_WEBHOOK_ENABLED=false
BALE_BOT_USERNAME=pakino_bot
BALE_INVOICE_TTL_SEC=1800
BALE_LINK_CODE_TTL_SEC=900
PAYMENT_DEFAULT_PROVIDER=
RECONCILE_TOKEN=
# Worker-side reconcile trigger (optional). Point at the web service's
# /api/payments/reconcile, e.g. http://web:3000/api/payments/reconcile.
PAYMENT_RECONCILE_URL=
PAYMENT_RECONCILE_INTERVAL_SECONDS=900
